// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum UserRole {
  USER // Suscriptor normal
  STAFF // Personal de validación QR
  ADMIN // Administrador total
}

enum EventMode {
  PRESENCIAL
  STREAMING
  HIBRIDO
}

enum EventStatus {
  DRAFT // Borrador
  PUBLISHED // Publicado y visible
  CANCELLED // Cancelado
  COMPLETED // Finalizado
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum OrderStatus {
  PENDING_PAYMENT // reserva de cupo activa, esperando pago o validación
  PAID
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CARD_OPENPAY // Openpay Argentina (BBVA) — docs.ecommercebbva.com
  BANK_TRANSFER // queda PENDING_PAYMENT hasta validación manual en backoffice
  MERCADOPAGO // Checkout Pro — confirmación async por webhook
  FREE // orden generada al aprobar un AccessRequest (acreditación), sin cobro real
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  PENDING_PAYMENT // reserva capacidad, todavia no valido para ingresar
  ACTIVE // pago confirmado, QR generado
  USED // ya validado en la puerta
  CANCELLED // orden fallida/rechazada/vencida
}

enum TicketTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

// Un mismo Contact puede acumular varios roles a la vez (ej. FAN +
// CLIENTE), por eso viven en una tabla puente (ContactRoleAssignment) y no
// como un enum simple en Contact.
enum ContactRole {
  FAN
  ARTISTA
  CLIENTE
  PROSPECTO
  PROVEEDOR
  PRENSA
  PARTNER
  EMBAJADOR
  AGENTE
}

enum AddonCategory {
  PRODUCTO
  SERVICIO
}

// ─────────────────────────────────────────
// Models
// ─────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String? // nullable: cuentas creadas solo con Google no tienen contraseña
  googleId     String?  @unique
  fullName     String
  role         UserRole @default(USER)
  refreshToken String? // Hashed refresh token

  // Reset de contraseña por email (self-service, comunidad). SHA-256 y no
  // bcrypt a propósito: necesitamos poder buscar por el token que llega en
  // la URL (WHERE passwordResetToken = sha256(token)) — bcrypt no es
  // determinístico, no se puede indexar/buscar así. Es seguro igual porque
  // el token es aleatorio de alta entropía y de un solo uso con expiración
  // corta, no una contraseña de largo plazo.
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?
  contact      Contact? // identidad unificada del ecosistema (INVS Core Data) — ver model Contact

  ordersAsBuyer             Order[]           @relation("OrderBuyer")
  ordersValidated           Order[]           @relation("OrderValidator")
  ticketsHeld               Ticket[]          @relation("TicketHolder")
  ticketsPurchased          Ticket[]          @relation("TicketPurchaser")
  transfersSent             TicketTransfer[]  @relation("TransferSender")
  transfersReceived         TicketTransfer[]  @relation("TransferRecipient")
  contentPurchases          ContentPurchase[] @relation("ContentPurchaseBuyer")
  contentPurchasesValidated ContentPurchase[] @relation("ContentPurchaseValidator")
  storePurchases            StorePurchase[]   @relation("StorePurchaseBuyer")
  storePurchasesValidated   StorePurchase[]   @relation("StorePurchaseValidator")
  accessRequests            AccessRequest[]   @relation("AccessRequestRequester")
  accessRequestsReviewed    AccessRequest[]   @relation("AccessRequestReviewer")

  @@map("users")
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String             @unique
  planName   String // "basic", "premium", etc.
  status     SubscriptionStatus @default(ACTIVE)
  platform   String? // "ios", "android", "web", "manual"
  externalId String? // Apple/Google transaction ID

  startsAt  DateTime  @default(now())
  expiresAt DateTime? // null = sin vencimiento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// Identidad unificada del ecosistema INVS (INVS OS — Fase 0). User sigue
// siendo la cuenta autenticada de la app (login/JWT, con todas sus
// relaciones de compras existentes intactas); Contact es la capa por
// encima que también cubre prospectos/leads que todavía no se
// registraron (ej. un DM de Instagram o un contacto de WhatsApp sin
// cuenta). No duplica FKs de compras/tickets: la "vista 360" de un
// contacto se arma en el service leyendo las relaciones ya existentes de
// User cuando contact.userId no es null.
model Contact {
  id       String  @id @default(uuid())
  userId   String? @unique // null hasta que el contacto se registra/compra en la app
  email    String? @unique
  phone    String? @unique
  fullName String?
  source   String? // "instagram_dm", "whatsapp", "web_signup", "evento", "manual", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  roleAssignments ContactRoleAssignment[]

  @@map("contacts")
}

// Un contacto puede tener varios roles activos a la vez (ver enum
// ContactRole) — esta tabla puente es la que lo permite.
model ContactRoleAssignment {
  id        String      @id @default(uuid())
  contactId String
  role      ContactRole
  since     DateTime    @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, role])
  @@map("contact_role_assignments")
}

model Event {
  id                   String      @id @default(uuid())
  title                String
  description          String
  // La fecha puede cargarse aunque el evento no esté liberado todavía —
  // son cosas independientes. Lo que decide si el público ve "Próximamente"
  // o la fecha real (y si se pueden comprar entradas) es
  // commerciallyReleased, no si date es null.
  date                 DateTime?
  // false = "Próximamente" en el front, sin venta de entradas, aunque ya
  // tenga fecha cargada. El staff lo tilda a mano cuando está listo para
  // vender. Default false para eventos nuevos; el backfill de la migración
  // deja en true todo lo que ya existía (no puede des-vender nada).
  commerciallyReleased Boolean     @default(false)
  location             String?
  mode                 EventMode
  status               EventStatus @default(DRAFT)

  maxCapacity Int? // legacy: ya no se enforcea, la capacidad real vive en TicketCategory.maxCapacity

  // Streaming / Mux
  muxAssetId          String? // Asset ID de Mux (grabación/VOD)
  muxPlaybackId       String? // Playback ID público de Mux
  muxLiveId           String? // Live stream ID de Mux
  streamKey           String? // Stream key RTMP para OBS/broadcast
  rtmpUrl             String? // URL RTMP del ingest de Mux
  isLive              Boolean             @default(false)
  // Solo se setea para el live manual (sin muxLiveId) — el cron de
  // ManualLiveCleanupService lo usa para cortar solo si nadie lo hizo a mano.
  manualLiveStartedAt DateTime?
  // Qué proveedor eligió el admin para el live manual de este evento —
  // independiente del STREAMING_PROVIDER global, que es para Mux/el
  // proveedor "principal". Null si el evento no usa live manual.
  manualLiveProvider  ManualLiveProvider?

  // Acceso al streaming en vivo de este evento — combinable, igual que en
  // Recording: puede ser gratis, incluido en suscripción, y/o comprable
  // suelto (pay-per-view), todo a la vez.
  liveIsFree                 Boolean @default(false)
  liveIncludedInSubscription Boolean @default(true)
  livePriceCents             Int?
  liveCurrency               String  @default("ARS")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets          Ticket[]
  recordings       Recording[]
  categories       TicketCategory[]
  addonLinks       AddonEventLink[]
  orders           Order[]
  contentPurchases ContentPurchase[]
  photos           EventPhoto[]
  accessRequests   AccessRequest[]

  @@map("events")
}

// Categoria de entrada dentro de un evento: cada una puede tener su propio
// horario de experiencia (ej VIP entra 2hs antes que General) y su propio
// aforo (el limite de 50 simultaneos de Panda aplica ACA, por categoria,
// no como tope global del evento).
model TicketCategory {
  id             String    @id @default(uuid())
  eventId        String
  name           String // "VIP", "General", "Platea Alta"
  description    String?
  priceCents     Int
  currency       String    @default("ARS")
  maxCapacity    Int
  reservedCount  Int       @default(0) // contador atomico: pending_payment + active + used
  accessStartsAt DateTime? // hora de ingreso propia de esta categoria
  accessEndsAt   DateTime?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tickets        Ticket[]
  accessRequests AccessRequest[]

  @@map("ticket_categories")
}

// Catalogo de productos (remera, cuadro dorado, conmemorativo, merchandising
// suelto). Un producto puede venderse standalone en la Tienda (showInStore) y/o
// como complemento de 0..N eventos (AddonEventLink) — antes solo podía
// pertenecer a exactamente un evento. Este es el mismo patrón de tabla puente
// que se reutilizará para Servicios/Artistas a futuro, sin volver a migrar esto.
model AddOn {
  id            String        @id @default(uuid())
  name          String
  description   String?
  imageUrl      String?
  priceCents    Int
  currency      String        @default("ARS")
  category      AddonCategory @default(PRODUCTO)
  hasVariants   Boolean       @default(false) // true para remeras (talles) o para variantes de un servicio (ej. básico/premium)
  maxStock      Int?
  reservedStock Int           @default(0)
  isActive      Boolean       @default(true)
  showInStore   Boolean       @default(false) // visible en el catálogo standalone de la Tienda
  sortOrder     Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventLinks     AddonEventLink[]
  variants       AddonVariant[]
  orderAddons    OrderAddon[]
  storePurchases StorePurchase[]

  @@map("addons")
}

// Tabla puente producto↔evento (muchos a muchos): un mismo producto puede
// ser complemento de varios eventos a la vez.
model AddonEventLink {
  id      String @id @default(uuid())
  addonId String
  eventId String

  addon AddOn @relation(fields: [addonId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([addonId, eventId])
  @@map("addon_event_links")
}

model AddonVariant {
  id        String @id @default(uuid())
  addonId   String
  label     String // "S", "M", "L", "XL"
  sortOrder Int    @default(0)

  addon          AddOn           @relation(fields: [addonId], references: [id], onDelete: Cascade)
  orderAddons    OrderAddon[]
  storePurchases StorePurchase[]

  @@unique([addonId, label])
  @@map("addon_variants")
}

// Una compra: agrupa N tickets (de una o mas categorias del MISMO evento)
// + N adicionales. Reserva capacidad al crearse (aunque quede PENDING_PAYMENT).
model Order {
  id            String        @id @default(uuid())
  buyerId       String
  eventId       String
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod

  subtotalCents Int
  totalCents    Int
  currency      String @default("ARS")

  // Transferencia bancaria — validacion manual desde backoffice
  transferProofUrl  String?
  transferReference String?
  validatedByUserId String?
  validatedAt       DateTime?
  rejectionReason   String?

  // Openpay (BBVA Argentina)
  openpayChargeId String?
  paymentError    String?

  // Mercado Pago (Checkout Pro)
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?

  expiresAt DateTime? // TTL del hold de capacidad
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer         User           @relation("OrderBuyer", fields: [buyerId], references: [id])
  validatedBy   User?          @relation("OrderValidator", fields: [validatedByUserId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tickets       Ticket[]
  addons        OrderAddon[]
  accessRequest AccessRequest?

  @@index([status, paymentMethod])
  @@map("orders")
}

// Pedido de acceso sin compra ("tengo código de acceso" / acreditación de
// prensa) para cualquier evento. `code` es texto libre, sin validar contra
// nada — es solo referencia para que el staff decida a mano; la aprobación
// real es 100% humana. Al aprobar, se elige una TicketCategory y se genera
// una Order+Ticket reales con costo $0 (paymentMethod FREE), así el acceso
// se escanea/valida exactamente igual que una entrada comprada, sin tocar
// nada del flujo de venta existente.
model AccessRequest {
  id      String              @id @default(uuid())
  eventId String
  userId  String // quien pide el acceso (siempre logueado en invs-web)
  code    String? // texto libre que ingresa la persona, no se valida
  phone   String? // para que el staff pueda contactar/chequear antes de aprobar
  note    String? // opcional: medio/organización, motivo
  status  AccessRequestStatus @default(PENDING)

  categoryId String? // se completa al aprobar (el staff elige la categoría)
  orderId    String? @unique // se completa al aprobar

  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User            @relation("AccessRequestRequester", fields: [userId], references: [id])
  reviewedBy User?           @relation("AccessRequestReviewer", fields: [reviewedByUserId], references: [id])
  category   TicketCategory? @relation(fields: [categoryId], references: [id])
  order      Order?          @relation(fields: [orderId], references: [id])

  @@map("access_requests")
}

model OrderAddon {
  id             String  @id @default(uuid())
  orderId        String
  addonId        String
  variantId      String?
  quantity       Int     @default(1)
  unitPriceCents Int // snapshot del precio al momento de compra
  redeemedCount  Int     @default(0) // cuántas unidades ya se entregaron en el evento

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addon   AddOn         @relation(fields: [addonId], references: [id])
  variant AddonVariant? @relation(fields: [variantId], references: [id])

  @@map("order_addons")
}

model Ticket {
  id              String  @id @default(uuid())
  orderId         String
  categoryId      String
  eventId         String // denormalizado (debe == category.eventId), para queries simples
  holderUserId    String? // null hasta asignarse (entrada sin repartir / transferencia pendiente)
  purchaserUserId String // quien pago la orden

  status TicketStatus @default(PENDING_PAYMENT)

  // QR payload: JSON firmado con HMAC-SHA256, generado recien cuando status=ACTIVE
  // Contiene: ticketId, eventId, categoryId, issuedAt, expiresAt (SIN holder,
  // para que sobreviva a una transferencia posterior sin invalidarse)
  qrPayload String?   @unique
  usedAt    DateTime?
  scannedBy String? // userId del staff que escaneó
  expiresAt DateTime?

  createdAt DateTime @default(now())

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category  TicketCategory   @relation(fields: [categoryId], references: [id])
  event     Event            @relation(fields: [eventId], references: [id])
  holder    User?            @relation("TicketHolder", fields: [holderUserId], references: [id])
  purchaser User             @relation("TicketPurchaser", fields: [purchaserUserId], references: [id])
  transfers TicketTransfer[]

  @@map("tickets")
}

// Reenvio de una entrada por email, con doble confirmacion en el cliente y
// aceptacion del lado del destinatario (con registro inline si no tiene cuenta).
model TicketTransfer {
  id          String               @id @default(uuid())
  ticketId    String
  fromUserId  String
  toEmail     String // normalizado lowercase+trim
  toUserId    String? // se completa al aceptar
  status      TicketTransferStatus @default(PENDING)
  token       String               @unique // token opaco para el link del mail
  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUser User   @relation("TransferSender", fields: [fromUserId], references: [id])
  toUser   User?  @relation("TransferRecipient", fields: [toUserId], references: [id])

  @@index([ticketId, status])
  @@map("ticket_transfers")
}

model Recording {
  id          String  @id @default(uuid())
  eventId     String?
  title       String
  description String?

  // Fuente del video — una de dos:
  // (a) Mux Video on Demand (muxAssetId + muxPlaybackId), o
  // (b) URL externa (videoUrl, ej. YouTube) — el token endpoint devuelve
  //     la URL de embed con providerType para el StreamPlayer.
  muxAssetId    String?
  muxPlaybackId String?
  videoUrl      String?

  duration     Int? // segundos
  thumbnailUrl String?

  // Acceso combinable — no son excluyentes entre sí: un video puede ser
  // gratis, y/o estar incluido en la suscripción, y/o venderse suelto
  // (si priceCents tiene valor). Reemplaza los viejos isPublic/
  // requiresSubscription (a medio cablear, nunca se leían realmente).
  isFree                 Boolean @default(false)
  includedInSubscription Boolean @default(true)
  priceCents             Int?
  currency               String  @default("ARS")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event            Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  contentPurchases ContentPurchase[]

  @@map("recordings")
}

// Compra individual de contenido (grabación o acceso en vivo pay-per-view),
// separado de Order (que es para entradas de evento con cupo/categorías).
// Mismo espíritu de pago/validación que Order, sin reserva de aforo.
// Exactamente uno de recordingId/eventId debe estar seteado — se enforcea
// con un CHECK agregado a mano en la migración (Prisma no lo soporta en
// el DSL), ver migración `contenido_streaming_comprable_y_google_login`.
model ContentPurchase {
  id            String        @id @default(uuid())
  userId        String
  recordingId   String?
  eventId       String? // compra de acceso en vivo (pay-per-view)
  status        OrderStatus
  paymentMethod PaymentMethod
  priceCents    Int
  currency      String        @default("ARS")

  transferProofUrl  String?
  transferReference String?
  validatedByUserId String?
  validatedAt       DateTime?
  rejectionReason   String?

  openpayChargeId String?
  paymentError    String?

  // Mercado Pago (Checkout Pro)
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?

  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation("ContentPurchaseBuyer", fields: [userId], references: [id])
  validator User?      @relation("ContentPurchaseValidator", fields: [validatedByUserId], references: [id])
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("content_purchases")
}

// Compra individual de un producto de la Tienda (standalone, sin pasar por
// comprar una entrada). Mismo espíritu que ContentPurchase: sin reserva de
// aforo, mismo ciclo de pago (tarjeta/transferencia/Mercado Pago).
model StorePurchase {
  id            String        @id @default(uuid())
  userId        String
  addonId       String
  variantId     String?
  quantity      Int           @default(1)
  status        OrderStatus
  paymentMethod PaymentMethod
  priceCents    Int // snapshot: precio unitario x quantity al momento de compra
  currency      String        @default("ARS")

  transferProofUrl  String?
  transferReference String?
  validatedByUserId String?
  validatedAt       DateTime?
  rejectionReason   String?

  openpayChargeId String?
  paymentError    String?

  // Mercado Pago (Checkout Pro)
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?

  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation("StorePurchaseBuyer", fields: [userId], references: [id])
  validator User?         @relation("StorePurchaseValidator", fields: [validatedByUserId], references: [id])
  addon     AddOn         @relation(fields: [addonId], references: [id], onDelete: Restrict)
  variant   AddonVariant? @relation(fields: [variantId], references: [id])

  @@map("store_purchases")
}

// Credenciales de proveedores de pago configurables desde el backoffice (hoy
// solo Mercado Pago), en vez de fijas en variables de entorno. Un solo
// negocio ⇒ un solo registro por proveedor, no hay noción de organizador.
// accessTokenCipher va cifrado (AES-256-GCM), ver src/common/utils/credentials-crypto.util.ts.
model PaymentSettings {
  id                  String   @id @default(uuid())
  provider            String   @unique // 'mercadopago'
  environment         String // 'sandbox' | 'production'
  accessTokenCipher   String
  // Clave secreta de verificación de webhooks (distinta del access token,
  // se obtiene en el panel de notificaciones/webhooks de Mercado Pago).
  webhookSecretCipher String?
  publicKey           String?
  lastFour            String? // para mostrar "•••• 1234" sin exponer la key completa
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("payment_settings")
}

model EventPhoto {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("event_photos")
}

// Paleta de colores global de INVS (backoffice + invs-web), configurable
// desde el backoffice sin redeploy. Una sola fila para siempre.
model ThemeSettings {
  id                 String   @id @default("singleton")
  colorBg            String   @default("#0B0C0E")
  colorSurface       String   @default("#15171A")
  colorBorder        String   @default("#30343A")
  colorAccent        String   @default("#D9F5F8")
  colorAccentHover   String   @default("#F4FEFF")
  colorText          String   @default("#F4F4F2")
  colorTextSecondary String   @default("#B8BBC0")
  colorTextMuted     String   @default("#7C8188")
  colorSuccess       String   @default("#3DCC8C")
  colorDanger        String   @default("#FF626A")
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("theme_settings")
}

enum ThemeModule {
  EVENTS
  STREAMING
}

// Proveedores soportados para el live manual (el admin transmite por su
// cuenta desde OBS y solo pega el link/canal — sin API de creación de
// stream de por medio, a diferencia de Mux).
enum ManualLiveProvider {
  YOUTUBE
  TWITCH
}

// Override parcial de la paleta global por módulo de invs-web (no aplica a
// invs-backoffice, que se queda con un único tema). Cada color es nullable:
// null significa "hereda el valor de ThemeSettings", no "usa un default
// propio" — el merge lo hace ThemeService, nunca el cliente.
model ThemeModuleOverride {
  id                 String      @id @default(cuid())
  module             ThemeModule @unique
  colorBg            String?
  colorSurface       String?
  colorBorder        String?
  colorAccent        String?
  colorAccentHover   String?
  colorText          String?
  colorTextSecondary String?
  colorTextMuted     String?
  colorSuccess       String?
  colorDanger        String?
  updatedByUserId    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("theme_module_overrides")
}

enum LandingStatus {
  DRAFT
  PUBLISHED
}

// Landing armada por bloques (ver documentación de producto) — el contenido
// vive como datos (JSON), no como código, para poder publicar sin deploy.
// `blocks` es un array de objetos { id, type, content, style }; la validación
// de forma vive en CreateLandingDto/UpdateLandingDto, no en el schema (Json
// no puede expresar la unión de tipos de bloque acá).
model Landing {
  id              String        @id @default(cuid())
  slug            String        @unique
  status          LandingStatus @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  seoOgImage      String?
  blocks          Json          @default("[]")
  // Escape hatch acotado a esta landing — ver la sección de estilos en la
  // documentación de producto sobre por qué esto es aceptable y CSS
  // arbitrario en el cliente no lo sería.
  customCss       String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("landings")
}
